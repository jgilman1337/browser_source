{
	"name": "browser_source",
	"version": "1.0.0",
	"main": "src/index.ts",
	"type": "module",
	"engines": {
		"node": ">=24.21.0"
	},
	"scripts": {
		"start": "tsx src/index.ts",
		"lint": "eslint src --report-unused-disable-directives --max-warnings 0",
		"lint:fix": "eslint src --fix",
		"format": "prettier --write src/**/*.{html,js,ts,tsx,scss,md,css} --no-error-on-unmatched-pattern",
		"format:check": "prettier --check src/**/*.{html,js,ts,tsx,scss,md,css} --no-error-on-unmatched-pattern",
		"typecheck": "tsc --noEmit",
		"docker:build": "docker build -t browser_source .",
		"docker:run": "npm run docker:build && docker run --rm -it --init --gpus all --device /dev/dri:/dev/dri --shm-size=2g --add-host=host.docker.internal:host-gateway -e CONFIG_PATH=/app/config.json -v \"${PWD}/config.json:/app/config.json:ro\" browser_source"
	},
	"dependencies": {
		"puppeteer": "^25.9.0",
		"puppeteer-stream": "^3.0.23",
		"tsx": "^4.21.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.4.1",
		"@typescript-eslint/eslint-plugin": "^8.69.0",
		"@typescript-eslint/parser": "^8.69.0",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3"
	}
}