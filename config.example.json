{
	"targetUrl": "https://your-livestream-source.com",
	"outputUrl": "srt://host.docker.internal:5000?mode=caller",
	"clickPlayTarget": ".play-button",
	"hideScrollbars": false,
	"width": 1280,
	"height": 720,
	"frameRate": 30,
	"navigation": {
		"timeoutMs": 15000,
		"waitUntil": "load"
	},
	"stream": {
		"audio": true,
		"video": true,
		"videoMbitsPerSecond": 12,
		"audioKbitsPerSecond": 192,
		"mimeType": "video/webm;codecs=vp9"
	},
	"puppeteer": {
		"headless": false,
		"args": [
			"--no-sandbox",
			"--disable-setuid-sandbox",
			"--disable-dev-shm-usage",
			"--enable-gpu",
			"--ignore-gpu-blocklist",
			"--disable-gpu-sandbox",
			"--use-gl=angle",
			"--use-angle=vulkan",
			"--enable-features=VaapiVideoDecoder,VaapiIgnoreDriverChecks,Vulkan"
		]
	},
	"ffmpeg": {
		"videoCodec": "libx264",
		"audioCodec": "aac",
		"format": "mpegts",
		"hideBanner": true,
		"logLevel": "warning",
		"stats": true,
		"statsPeriod": 5,
		"retries": 10,
		"retryAfter": 5,
		"extraArgs": ["-rc", "cbr", "-b:v", "4M", "-maxrate", "4M", "-bufsize", "8M", "-b:a", "192k"]
	}
}
