{
	"targetUrl": "https://your-livestream-source.com",
	"outputUrl": "srt://host.docker.internal:5000?mode=caller",
	"clickPlayTarget": ".play-button",
	"hideScrollbars": false,
	"width": 1280,
	"height": 720,
	"frameRate": 30,
	"navigation": {
		"timeoutMs": 15000,
		"waitUntil": "load"
	},
	"stream": {
		"audio": true,
		"video": true
	},
	"puppeteer": {
		"headless": false,
		"args": ["--no-sandbox", "--disable-setuid-sandbox", "--disable-dev-shm-usage"]
	},
	"ffmpeg": {
		"videoCodec": "libx264",
		"audioCodec": "aac",
		"format": "mpegts",
		"hideBanner": true,
		"logLevel": "warning",
		"stats": true,
		"statsPeriod": 5,
		"extraArgs": []
	}
}
